# Copy to .env and adjust as needed. All values are optional.

# Force mock mode even if ML libraries are installed (great for fast dev / CI).
MOCK_MODE=false

# HuggingFace model ids
CAPTION_MODEL=Salesforce/blip-image-captioning-large
TEXT_MODEL=google/flan-t5-base
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# "cpu" or "cuda". Leave blank to auto-detect.
DEVICE=

# How many RAG knowledge-base entries to retrieve per image.
RAG_TOP_K=3

# CORS origins for the Angular dev server.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
